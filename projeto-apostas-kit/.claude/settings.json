{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python3 scripts/rag/search.py:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(gofmt -l:*)",
      "Bash(golangci-lint run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(python3 scripts/rag/build_index.py)",
      "Bash(python3 scripts/rag/fetch_docs.py:*)",
      "Bash(go mod tidy)",
      "Bash(gofmt -w:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose build:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(migrate:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase:*)",
      "Bash(git revert:*)",
      "Bash(git stash drop:*)",
      "Bash(git branch -D:*)",
      "Bash(sudo:*)",
      "Bash(docker system prune:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./docs/requisitos/desafio.md)",
      "Write(./docs/requisitos/desafio.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/safety/guard.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/safety/guard.py\""
          }
        ]
      }
    ]
  }
}
