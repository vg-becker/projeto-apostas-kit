# Valores locais de exemplo. Copie para .env (ignorado pelo git). Sem segredos reais.
APP_HTTP_ADDR=:8081
APP_SHUTDOWN_TIMEOUT=30s
APP_LOG_LEVEL=info

POSTGRES_USER=apostas
POSTGRES_PASSWORD=apostas_local
POSTGRES_DB=apostas
POSTGRES_PORT=5432
DATABASE_URL=postgres://apostas:apostas_local@localhost:5432/apostas?sslmode=disable

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

KEYCLOAK_PORT=8080
OIDC_ISSUER_URL=http://localhost:8080/realms/apostas
OIDC_AUDIENCE=apostas-api
OIDC_INTERNAL_SCOPE=wallet:internal
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
